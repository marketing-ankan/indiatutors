APP_NAME="IndiaTutors Online"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/indiatutors/public
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=indiatutors
DB_USERNAME=root
DB_PASSWORD=

FRONTEND_URL=http://127.0.0.1:5173

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Razorpay (Phase 7) — leave empty to keep the pending-payment stub at checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Bunny.net Stream (paid video-course playback) — empty = preview-only
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=

# Cloudflare R2 (paid video-course playback, free egress) — empty = preview-only.
# Create a private bucket + an R2 API token with Object Read for that bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Course study assistant (lesson summaries + Q&A) — empty = feature hidden.
# Falls back to GEMINI_API_KEY if AI_API_KEY is unset.
AI_PROVIDER=gemini
AI_API_KEY=
# -latest alias, not a pinned version: free-tier quota moves between Gemini
# versions and a pin silently dies with it (2.0-flash hit `limit: 0` 2026-08).
AI_MODEL=gemini-flash-latest

# Instagram Graph API token (course-page Instagram Feed) — empty = branded
# placeholder tiles. With a token, the latest posts auto-refresh hourly.
INSTAGRAM_ACCESS_TOKEN=

# Physical / home tuition -----------------------------------------------------
# The external teacher-assignment app reads /api/matching/v1/* with this key in
# an X-Matching-Key header. EMPTY = the whole export 503s. It exposes teacher
# and student home addresses, so it is never open by default — generate a long
# random value and share it only with that app.
# Contract: docs/MATCHING-DATA-CONTRACT.md
MATCHING_API_KEY=

# Pincode -> district/state autofill. The bundled `pincodes` table answers
# first; this controls whether an unknown pincode may fall through to India
# Post's open endpoint (no key needed). Set false to stay fully offline.
PINCODE_LOOKUP_API=true

# Mail. 'log' writes messages to storage/logs instead of sending them, which is
# what you want locally — and what production still uses, so no lead email is
# actually delivered yet. Switching this to smtp (plus host/port/username/
# password) is the single change that turns lead notifications on.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="connect@indiatutorsonline.com"
MAIL_FROM_NAME="IndiaTutors Online"

# The Staff Console sign-in created by AdminSeeder. Taken LITERALLY — do not
# wrap the password in angle brackets or quotes you do not want in it.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=
